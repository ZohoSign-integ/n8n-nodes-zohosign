{
    "name": "@zohosign/n8n-nodes-sign",
    "version": "1.0.1",
    "description": "Interact with Zoho Sign API",
    "license": "MIT",
    "homepage": "",
    "keywords": [
        "n8n-community-node-package"
    ],
    "author": {
        "name": "ZohoSign-integ",
        "email": "integrations@zohosign.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ZohoSign-integ/n8n-nodes-zohosign.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/ZohoSignOAuth2Api.credentials.js"
        ],
        "nodes": [
            "dist/nodes/ZohoSign/ZohoSign.node.js",
            "dist/nodes/ZohoSign/ZohoSignTrigger.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2",
        "@types/node": "^24.9.1"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    },
    "dependencies": {}
}
